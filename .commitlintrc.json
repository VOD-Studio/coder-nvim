{
  "$schema": "https://raw.githubusercontent.com/conventional-commit-lint/conventional-commitlint/master/%40commitlint/config-conventional/schema.json",
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      ["feat", "fix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore", "revert"]
    ],
    "subject-case": [0]
  }
}
