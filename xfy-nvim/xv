#!/bin/sh
# xv — host-side wrapper that runs Neovim inside the xfy-nvim container.
# Maps host ~/.xfy-nvim/{config,data,state,cache} to in-container nvim stdpaths,
# mounts $PWD at /workdir, and passes HOST_UID/HOST_GID so the entrypoint
# can match the container's coder user to the host user (files written by
# nvim land owned by the host user, not root).
#
# Usage:
#   xv              # open empty buffer
#   xv file.rs      # open file in $PWD
#   xv folder/      # open directory (netrw / neo-tree / oil)
#   xv /abs/path    # open file outside $PWD (parent dir also mounted)
#   xv --help       # show this help
#
# Environment:
#   XV_IMAGE        image name              (default: xfy-nvim)
#   XV_TAG          image tag               (default: latest)
#   XV_HOME         host state root         (default: ~/.xfy-nvim)
#   XV_CONFIG_DIR   host nvim config dir    (default: $XV_HOME/config)
#   XV_DATA_DIR     host nvim data dir      (default: $XV_HOME/data)
#   XV_STATE_DIR    host nvim state dir     (default: $XV_HOME/state)
#   XV_CACHE_DIR    host nvim cache dir     (default: $XV_HOME/cache)
# Proxy passthrough: http_proxy / https_proxy / no_proxy / all_proxy / ftp_proxy
# (and their UPPERCASE variants) are inherited from the host shell so that
# git clone, :TSInstall, mason.nvim, conform.nvim all go through the host proxy.
#
# Known limitation: relative paths that escape $PWD (e.g. `xv ../sibling/f.rs`)
# are not rewritten. `cd ../sibling && xv f.rs` instead.
set -e

# --help：打印内嵌帮助（不依赖独立的 README.md）
case "${1:-}" in
  -h|--help|help)
    sed -n '2,30p' "$0"
    exit 0
    ;;
esac

IMAGE="${XV_IMAGE:-xfy-nvim}:${XV_TAG:-latest}"
XV_HOME_DIR="${XV_HOME:-${HOME}/.xfy-nvim}"
CONFIG_DIR="${XV_CONFIG_DIR:-${XV_HOME_DIR}/config}"
DATA_DIR="${XV_DATA_DIR:-${XV_HOME_DIR}/data}"
STATE_DIR="${XV_STATE_DIR:-${XV_HOME_DIR}/state}"
CACHE_DIR="${XV_CACHE_DIR:-${XV_HOME_DIR}/cache}"

mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$STATE_DIR" "$CACHE_DIR"

VOLUMES="-v ${PWD}:/workdir"
VOLUMES="$VOLUMES -v ${CONFIG_DIR}:/home/coder/.config/nvim"
VOLUMES="$VOLUMES -v ${DATA_DIR}:/home/coder/.local/share/nvim"
VOLUMES="$VOLUMES -v ${STATE_DIR}:/home/coder/.local/state/nvim"
VOLUMES="$VOLUMES -v ${CACHE_DIR}:/home/coder/.cache/nvim"

# 绝对路径参数：把父目录挂到容器内相同路径，让 nvim 能访问 PWD 外的文件
for arg in "$@"; do
  case "$arg" in
    /*) parent=$(dirname "$arg"); [ -d "$parent" ] && VOLUMES="$VOLUMES -v ${parent}:${parent}" ;;
  esac
done

# 仅当 stdin 是 tty 时分配伪终端（管道/重定向场景不需要 -t）
# || true 防止 set -e 在非 TTY 时因命令替换返回非零而中止整个脚本
TTY_OPT=$([ -t 0 ] && echo -t || true)

# shellcheck disable=SC2086
exec docker run --rm -i $TTY_OPT \
  $VOLUMES \
  -w /workdir \
  -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" \
  -e TERM="${TERM:-xterm-256color}" -e COLORTERM="$COLORTERM" \
  \
  --env http_proxy --env https_proxy --env no_proxy --env all_proxy --env ftp_proxy \
  --env HTTP_PROXY --env HTTPS_PROXY --env NO_PROXY --env ALL_PROXY --env FTP_PROXY \
  \
  "$IMAGE" nvim "$@"
